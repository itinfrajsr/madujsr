# File konfigurasi/data tidak boleh diakses langsung; admin tetap bisa dibuka.
<FilesMatch "^(config|config\.local|bootstrap|db|functions|data|render|seed|admin_lib|crud_config|settings_config)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "\.(sqlite|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
